{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "govtrack",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    // El build de React se sirve como SPA; /api/* lo atiende el Worker.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "govtrack",
      // Reemplazar por el id real al crear la BD remota (npx wrangler d1 create govtrack).
      // Para desarrollo local cualquier valor sirve.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
